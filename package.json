{
  "name": "trustpay-nigeria-msme",
  "version": "2.0.0-r1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "check": "npm run verify:repo && npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:repo": "node scripts/verify-repo.mjs",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:static": "tsc -p tsconfig.static.json",
    "test:core": "rm -rf .tmp/core && tsc -p tsconfig.core.emit.json && node scripts/core-smoke.cjs",
    "test:v2": "node scripts/v2-smoke.cjs",
    "check:v2": "npm run verify:repo && npm run typecheck && npm run test:v2 && npm run test:r1-schema",
    "test:r1-schema": "node scripts/r1-schema-adversarial.cjs",
    "test:r1-preview": "node scripts/r1-preview-smoke.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.0",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.7",
    "@types/react-dom": "19.1.6",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.19.1"
}
