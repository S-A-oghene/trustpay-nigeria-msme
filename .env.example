# ===== BASIC DEPLOYMENT =====
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.example
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CURRENCY=NGN
NEXT_PUBLIC_LOCALE=en-NG

# ===== SUPABASE / PRODUCTION DATA =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=server_only_replace_me

# ===== PAYMENTS =====
PAYMENT_PROVIDER=demo
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ===== IDENTITY =====
IDENTITY_PROVIDER=demo
IDENTITY_PROVIDER_API_KEY=

# ===== CAC / REGISTRY =====
REGISTRY_PROVIDER=demo
REGISTRY_PROVIDER_API_KEY=

# ===== MESSAGING =====
MESSAGING_PROVIDER=demo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# ===== FILE SECURITY =====
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_SCAN_PROVIDER=demo
DOCUMENT_SCAN_PROVIDER_API_KEY=

# ===== ADMIN / OPERATIONS =====
ADMIN_EMAILS=replace-with-controlled-addresses
CRON_SHARED_SECRET=

# DEMO MODE requires no provider credential. Production provider keys must be stored
# in the hosting platform's encrypted environment-variable settings, never in Git.
